# PostgreSQL (required for Vercel / any Node host). Local SQLite is not used.
# Instant free DB (claim within 24h to keep):  npx create-db@latest
# Or Vercel Postgres / Neon / any hosted Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Sign session cookies. Use a long random string in production.
#   openssl rand -base64 48
SESSION_SECRET="change-me-generate-a-long-random-string"

# Shared PIN for the /ops desk (status + invoice). Break-glass only.
# Day-to-day staff use email + password. Staging default below; change before cutover.
OPS_PIN="local-ops"

# First admin (never commit the password):
#   ADMIN_EMAIL=hdossantos@medsteadgroup.com ADMIN_PASSWORD='…' npm run db:seed-admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# RESET_ADMIN_PASSWORD=

# Optional local demo staff (staff / pilot / cargo @medstead.demo):
# SEED_DEMO_STAFF=1
# DEMO_STAFF_PASSWORD=

# Future MTG Airways app → this platform. Empty means token auth is off
# (schedule-capable staff sessions still work).
# AIRLINE_APP_TOKEN=
