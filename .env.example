# PostgreSQL (required for Vercel / any Node host). Local SQLite is not used.
# Instant free DB (claim within 24h to keep):  npx create-db@latest
# Or Vercel Postgres / Neon / any hosted Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Sign session cookies. Use a long random string in production.
#   openssl rand -base64 48
SESSION_SECRET="change-me-generate-a-long-random-string"

# Shared PIN for the /ops desk (status + invoice). Not a customer password.
# Staging default below; change before any public production cutover.
OPS_PIN="local-ops"

# Optional display label written to paidBy audit (never the PIN).
# OPS_STAFF_LABEL="ops-desk"
